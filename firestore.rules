rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Notlar — Sayfalar ve Bloklar
    match /pages/{pageId} {
      allow read, write: if true;
      match /blocks/{blockId} {
        allow read, write: if true;
      }
    }

    // Posta Hesapları (kimlik bilgileri)
    match /mailAccounts/{accountId} {
      allow read, write: if true;
    }

    // Varsayılan: Kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
