// Prisma schema for Clown App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MailAccount {
  id          String   @id @default(uuid())
  provider    String   // GMAIL, OUTLOOK, IMAP
  email       String   @unique
  status      String   @default("connected") // connected, error, sync_pending
  credentials String?  // Encrypted OAuth/IMAP credentials token
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id           String        @id @default(uuid())
  userId       String        @default("akif")
  parentPageId String?
  title        String        @default("Başlıksız Sayfa")
  icon         String        @default("description")
  coverImage   String?
  sortOrder    Int           @default(0)
  isArchived   Boolean       @default(false)
  isFavorite   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastOpenedAt DateTime?
  deletedAt    DateTime?
  
  parentPage   Page?         @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: Cascade)
  subPages     Page[]        @relation("PageHierarchy")
  blocks       Block[]
  tasks        Task[]
  attachments  Attachment[]
  versions     PageVersion[]
}

model Block {
  id             String    @id @default(uuid())
  pageId         String
  parentBlockId  String?
  blockType      String    // paragraph, heading, checklist, bullet, toggle, quote, callout, divider, code, table
  content        String    @default("")
  propertiesJson String?   // Görev veya tablo gibi özel verileri JSON saklar
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  page           Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Label {
  id        String          @id @default(uuid())
  userId    String          @default("akif")
  name      String          @unique
  color     String          @default("#757575")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  relations LabelRelation[]
}

model LabelRelation {
  id         String   @id @default(uuid())
  labelId    String
  entityType String   // folder, notebook, page, task
  entityId   String
  createdAt  DateTime @default(now())
  label      Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
}

model Task {
  id           String    @id @default(uuid())
  userId       String    @default("akif")
  pageId       String
  blockId      String
  title        String
  description  String?
  status       String    @default("TODO") // TODO, IN_PROGRESS, ON_HOLD, DONE, CANCELLED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  dueDate      DateTime?
  reminderDate DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String    @id @default(uuid())
  userId    String    @default("akif")
  pageId    String
  blockId   String
  fileName  String
  fileType  String
  fileSize  Int
  fileUrl   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageVersion {
  id              String   @id @default(uuid())
  pageId          String
  contentSnapshot String
  createdAt       DateTime @default(now())
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model RecentItem {
  id        String   @id @default(uuid())
  userId    String   @default("akif")
  pageId    String
  openedAt  DateTime @default(now())
}

model TrackedInstagramAccount {
  id          String   @id @default(uuid())
  handle      String   @unique
  name        String
  category    String
  followers   String
  growth      String
  engagement  String
  avatarUrl   String
  postsJson   String   // JSON array of image URLs
  addedAt     DateTime @default(now())
}

model CachedEvent {
  id        String   @id @default(uuid())
  title     String
  date      String   // YYYY-MM-DD
  startTime String   // e.g. "09:00 AM"
  endTime   String   // e.g. "10:30 AM"
  location  String?
  category  String   @default("Work")
  isUrgent  Boolean  @default(false)
  provider  String   @default("Local")
  createdAt DateTime @default(now())
}
